# Copy this to .env and fill in your values
DATABASE_URL="postgresql://username:password@host:5432/dbname?sslmode=require"
SESSION_SECRET="generate-a-random-32-char-string-here"

# Dev ports (must be different). Start both with: pnpm dev
API_PORT=5000
FRONTEND_PORT=5173

# Replit sets PORT per service; locally use API_PORT + FRONTEND_PORT instead.
BASE_PATH=/

# Appwrite storage (optional — enables file uploads instead of base64 in DB)
# Create a bucket with public read access for uploaded files.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=

# Wipe all data (users, events, messages, etc.) — requires --confirm flag:
# pnpm --filter @workspace/scripts run reset -- --confirm
